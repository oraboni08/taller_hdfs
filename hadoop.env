# ==========================================================
# Configuración compartida del clúster (imágenes bde2020)
# El entrypoint convierte cada variable en una propiedad XML:
#   CORE_CONF_*   -> core-site.xml      HDFS_CONF_*   -> hdfs-site.xml
#   YARN_CONF_*   -> yarn-site.xml      MAPRED_CONF_* -> mapred-site.xml
#   "_" = "."   "__" = "_"   "___" = "-"
# ==========================================================

# Memoria máxima de cada proceso Java del clúster (Docker Desktop suele tener ~4 GB)
HADOOP_HEAPSIZE_MAX=256m

# ---------- core-site.xml ----------
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root

# ---------- hdfs-site.xml ----------
# Solo hay 2 DataNodes: cada bloque se guarda 2 veces (una en cada nodo)
HDFS_CONF_dfs_replication=2
# Bloques de 4 MB para que los datasets (~10-15 MB) se partan en varios bloques y varios maps
HDFS_CONF_dfs_blocksize=4194304
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
# Detección rápida de DataNodes caídos (por defecto tarda ~10,5 min):
# tiempo para marcarlo "Dead" = 2 x recheck-interval + 10 x heartbeat = 2x15 s + 10x3 s = 60 s
HDFS_CONF_dfs_heartbeat_interval=3
HDFS_CONF_dfs_namenode_heartbeat_recheck___interval=15000

# ---------- yarn-site.xml ----------
YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
YARN_CONF_yarn_nodemanager_aux___services=mapreduce_shuffle
# Recursos que cada NodeManager ofrece al clúster
YARN_CONF_yarn_nodemanager_resource_memory___mb=1536
YARN_CONF_yarn_nodemanager_resource_cpu___vcores=2
YARN_CONF_yarn_scheduler_minimum___allocation___mb=128
YARN_CONF_yarn_scheduler_maximum___allocation___mb=1024
YARN_CONF_yarn_nodemanager_vmem___check___enabled=false
# Un NodeManager que deja de responder se marca LOST a los 30 s (por defecto 10 min)
YARN_CONF_yarn_nm_liveness___monitor_expiry___interval___ms=30000
# Guardar los logs de cada job en HDFS para leerlos con "yarn logs"
YARN_CONF_yarn_log___aggregation___enable=true
YARN_CONF_yarn_nodemanager_remote___app___log___dir=/app-logs
YARN_CONF_yarn_log_server_url=http://historyserver:8188/applicationhistory/logs/
# HistoryServer (Timeline Server): historial de aplicaciones terminadas
YARN_CONF_yarn_timeline___service_enabled=true
YARN_CONF_yarn_timeline___service_generic___application___history_enabled=true
YARN_CONF_yarn_timeline___service_hostname=historyserver
YARN_CONF_yarn_resourcemanager_system___metrics___publisher_enabled=true

# ---------- mapred-site.xml ----------
# Sin esta línea los jobs corren en modo LOCAL y nunca aparecen en YARN
MAPRED_CONF_mapreduce_framework_name=yarn
MAPRED_CONF_yarn_app_mapreduce_am_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1/
MAPRED_CONF_mapreduce_map_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1/
MAPRED_CONF_mapreduce_reduce_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1/
MAPRED_CONF_yarn_app_mapreduce_am_resource_mb=512
MAPRED_CONF_yarn_app_mapreduce_am_command___opts=-Xmx384m
MAPRED_CONF_mapreduce_map_memory_mb=384
MAPRED_CONF_mapreduce_map_java_opts=-Xmx256m
MAPRED_CONF_mapreduce_reduce_memory_mb=384
MAPRED_CONF_mapreduce_reduce_java_opts=-Xmx256m
